EXT SOURCES
<-Volume-> <Member> SsysSgap<--Mult-->Tran <-Target vols> <-Grp> <-Member-> ***
<Name>   x <Name> x tem strg<-factor->strg <Name>   x   x        <Name> x x ***
WDM2  6802 HPCP     ENGL              SAME PERLND 101 249 EXTNL  PREC
WDM2   606 HPET     ENGL              SAME PERLND 101 249 EXTNL  PETINP

WDM2  6802 HPCP     ENGL              SAME RCHRES   1   2 EXTNL  PREC
WDM2   606 HPET     ENGL              SAME RCHRES   1   2 EXTNL  POTEV

*** Transfer the well stage data to COPY
WDM1  1600 STAGE    ENGL              SAME COPY     1     INPUT  MEAN   1
END EXT SOURCES

NETWORK
<-Volume-> <-Grp> <-Member-><--Mult-->Tran <-Target vols> <-Grp> <-Member->  ***
<Name>   x        <Name> x x<-factor->strg <Name>   x   x        <Name> x x  ***
GENER    1 OUTPUT TIMSER                   RCHRES   1     INFLOW IVOL
END NETWORK

SCHEMATIC
<-Volume->                  <--Area-->     <-Volume->  <ML#> ***       <sb>
<Name>   x                  <-factor->     <Name>   x        ***        x x
PERLND 101                      300.0      RCHRES   1      1
END SCHEMATIC

EXT TARGETS
<-Volume-> <-Grp> <-Member-><--Mult-->Tran <-Volume-> <Member> Tsys Aggr Amd ***
<Name>   x        <Name> x x<-factor->strg <Name>   x <Name>qf  tem strg strg***
***  HYDROLOGY
RCHRES   1 HYDR   STAGE               AVER WDM1  2000 STAGE    ENGL AGGR REPL
RCHRES   1 HYDR   SAREA               AVER WDM1  2001 SAREA    ENGL AGGR REPL
GENER    1 OUTPUT TIMSER              SUM  WDM1  2005 IVOL     ENGL AGGR REPL
END EXT TARGETS

MASS-LINK
  MASS-LINK        1
<-Volume-> <-Grp> <-Member-><--Mult-->Tran <-Target vols> <-Grp> <-Member-> ***
<Name>            <Name> x x<-factor->strg <Name>                <Name> x x ***
PERLND     PWATER PERO        0.083333     RCHRES         INFLOW IVOL
  END MASS-LINK    1
END MASS-LINK

SPEC-ACTIONS
***
***                                                     lc ls ac as agfn
***kwrd> <uqnm> <oper> <#> <vari><1><2><3><t><multfact> <>< > <>< > <  >

*** Lake variables
  UVQUAN lkstag RCHRES   1 STAGE
  UVQUAN lkarea RCHRES   1 SAREA

*** Groundwater elevation
  UVQUAN gwstag COPY     1 MEAN

*** Workspace: HDIFF:head difference in feet and KVALUE:leakance in units of /day
***
***                                                     lc ls ac as agfn
***kwrd> <uqnm> <oper> <#> <vari><1><2><3><t><multfact> <>< > <>< > <  >
  UVQUAN hdiff  GLOBAL     WORKSP 10
  UVQUAN kvalue GLOBAL     WORKSP 11
  UVQUAN gwflux GLOBAL     WORKSP 12
  UVQUAN offset GLOBAL     WORKSP 13
***
***             cnt                       act                           act
***kwrd>  <unam>< > <vari><1><2><3> <frc> <  >    <vari><1><2><3> <frc> <  >
  UVNAME  HDIFF   1 WORKSP 10        1.0  QUAN
  UVNAME  KVALUE  1 WORKSP 11        1.0  QUAN
  UVNAME  GWFLUX  1 WORKSP 12        1.0  QUAN
  UVNAME  OFFSET  1 WORKSP 13        1.0  QUAN

*** Lake-GW calculations
***
***            dc ds                 d t                               tc ts num
***oper><f><-l><>< ><yr><m><d><h><m><><>  <vari><1><2><3><a><-value--> <> < >< >

*** Set leakance
  GENER   1                               KVALUE           =   5.0e-3
*** Set well offset: constant vertical difference between UFA at lake and well
  GENER   1                               OFFSET           =      0.0

*** Compute head difference
  GENER   1                               HDIFF            =   lkstag
  GENER   1                               HDIFF           -=   gwstag
*** If needed, apply offset. If not, comment out
  GENER   1                               HDIFF           +=   offset

*** Compute net flux
  GENER   1                               GWFLUX           =   hdiff
  GENER   1                               GWFLUX          *=   lkarea
  GENER   1                               GWFLUX          *=   kvalue

IF (hdiff >= 0.0) THEN
  *** compute groundwater exit loss- convert to cfs from ft3/day
  RCHRES  1                               OUTDGT  2        =   gwflux
  RCHRES  1                               OUTDGT  2       /=  86400.0

  *** No upward flux
  GENER   1                               K       1        =      0.0 
ELSE
  *** compute upward flux – convert to acre-feet/timestep
  GENER   1                               K       1        =   gwflux
  GENER   1                               K       1       /= -43560.0
  GENER   1                               K       1       /=     24.0

  *** No downward flux
  RCHRES  1                               OUTDGT  2        =      0.0
END IF

END SPEC-ACTIONS

END RUN
